{
  "name": "neeto-sign",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/neetozone/neeto-sign.git",
  "license": "MIT",
  "devDependencies": {
    "@redocly/cli": "2.25.3",
    "husky": "9.1.7",
    "mint": "4.2.577",
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "build": "scripts/bundle.sh",
    "build:dev": "nodemon --exec 'scripts/bundle.sh'",
    "docs:preview": "mint dev",
    "docs:publish": "bash scripts/publish_docs.sh",
    "docs:publish:check": "bash scripts/publish_docs.sh --dry-run",
    "check:openapi": "mint openapi-check",
    "check:links": "mint broken-links",
    "postinstall": "husky"
  },
  "packageManager": "yarn@4.18.1",
  "nodemonConfig": {
    "ext": "yaml",
    "watch": [
      "**"
    ],
    "ignore": [
      "bundled/**"
    ]
  }
}
